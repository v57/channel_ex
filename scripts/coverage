#!/usr/bin/env bash
set -euo pipefail
# In the Hub checkout this runs in its toolchain container (HubTools/hub-run); elsewhere it runs here.
hub_run="$(dirname "$0")/../../../HubTools/hub-run"
[[ -n "${HUB_TOOLCHAIN:-}" || ! -x "$hub_run" ]] || exec "$hub_run" bash "$0" "$@"

ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
cd "$ROOT"

mkdir -p coverage

mix deps.get >/dev/null
mix coveralls.lcov

if [[ ! -s cover/lcov.info ]]; then
  echo "cover/lcov.info was not generated" >&2
  exit 1
fi

cp cover/lcov.info coverage/lcov.info

if [[ ! -s coverage/lcov.info ]]; then
  echo "coverage/lcov.info was not generated" >&2
  exit 1
fi

echo "LCOV coverage written to coverage/lcov.info"
